# Streaming Configuration Template
# Copy this file to config.env and fill in your actual stream keys

# Video file to stream
# Download videos using: python3 download_youtube.py "URL"
# Then set this to your video filename
VIDEO_FILE="downloads/24x7LiveStreamPodcast - Made with Clipchamp.mp4"

# YouTube Live Stream Key
# Get this from: https://studio.youtube.com/channel/UC/livestreaming → Go Live → Stream Settings
YOUTUBE_STREAM_KEY=YOUTUBE_STREAM_KEY

# Instagram Live RTMP URL (base URL, stream key will be appended)
# This URL is dynamic and may change - get it from your Instagram Live stream settings
INSTAGRAM_RTMP_URL="rtmps://edgetee-upload-del2-1.xx.fbcdn.net:443/rtmp/"

# Instagram Live Stream Key
# Get this from https://www.instagram.com/accounts/settings/v2/archiving_and_downloading/
INSTAGRAM_STREAM_KEY="18137785216487552?s_bl=1&s_fbp=bom2-2&s_ow=10&s_prp=del2-1&s_sw=0&s_tids=1&s_vt=ig&a=Ab68sc5Ztc-_nrbWZB-kXtAD"
